{
  "name": "react-native-opengl-lab",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "prepare": "npm run assets",
    "assets": "node scripts/generate-models.mjs",
    "start": "expo start",
    "ios": "expo start --dev-client --ios",
    "ios:device": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 expo run:ios --device",
    "web": "expo start --web",
    "build:ios": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 expo run:ios",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist/web",
    "check": "tsc --noEmit",
    "android": "expo run:android",
    "angle:prepare": "node scripts/prepare-angle.mjs",
    "build:catalyst": "bash scripts/build-catalyst.sh",
    "catalyst": "open 'artifacts/catalyst/DerivedData/Build/Products/Release-maccatalyst/ReactOpenGLLab.app'",
    "angle:configure": "LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 expo prebuild --platform ios --no-install && LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 pod install --project-directory=ios",
    "windows": "powershell -ExecutionPolicy Bypass -File scripts/run-uwp.ps1",
    "build:uwp": "powershell -ExecutionPolicy Bypass -File scripts/build-uwp-release.ps1"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-windows": "0.81.4"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.0.2",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "metro-config": "^0.83.3",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "react-native-windows": {
    "init-windows": {
      "name": "OpenGLLab",
      "namespace": "OpenGLLab",
      "template": "old/uwp-cpp-app"
    }
  }
}
