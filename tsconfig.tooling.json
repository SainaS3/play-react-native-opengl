{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "metro.windows.ts"
  ]
}
